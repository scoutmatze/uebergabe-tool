# ------------------------------------------------------------------
# Datenbank (Postgres 16 – Container-intern)
# ------------------------------------------------------------------
DATABASE_URL="postgresql://uebergabe:CHANGE_ME@db:5432/uebergabe?schema=public"
POSTGRES_USER=uebergabe
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=uebergabe

# ------------------------------------------------------------------
# Auth (Auth-Library nutzt APP_SECRET + bcrypt-PIN)
# ------------------------------------------------------------------
APP_SECRET=CHANGE_ME_LONG_RANDOM
APP_URL=https://uebergabe.dpsgonline.de

# Erst-Admin (wird einmalig über /api/auth/bootstrap angelegt, solange noch kein User existiert)
ADMIN_EMAIL=admin@dpsg1300.de
ADMIN_PIN=CHANGE_ME

# ------------------------------------------------------------------
# OpenAI API
# Hol deinen API Key von https://platform.openai.com/api/keys
# (Prototype-Plan, $5/Monat, genug für gelegentliche Nutzung)
# ------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-CHANGE_ME"

# ------------------------------------------------------------------
# Speicher
# ------------------------------------------------------------------
AUDIO_DIR=/data/audio
MATERIAL_DIR=/data/material

